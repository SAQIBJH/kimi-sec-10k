{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Streamlit: Main Portal",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "${workspaceFolder}/app/main.py", "--server.port", "8501", "--server.runOnSave", "true"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/app"
            },
            "python": "${workspaceFolder}/.venv/bin/python"
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/app"
            },
            "python": "${workspaceFolder}/.venv/bin/python"
        }
    ]
}
